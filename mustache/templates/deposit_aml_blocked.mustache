{{> head}}
<body style="margin: 0; padding: 0; min-width: 100%; background-color: #f7f7f7">
    <!--[if (gte mso 9)|(IE)]>
    <style>body { background-color: #dde0e1 !important; }</style>
  <![endif]-->
    <style type="text/css">
        @media only screen and (max-width: 600px) {
            .email-container {
                width: 100% !important;
                max-width: 100% !important;
            }
            .stack {
                display: block !important;
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
                text-align: left !important;
            }
            .stack-label {
                margin-bottom: 8px !important;
                padding: 0 !important;
            }
            .stack-value {
                padding-bottom: 24px !important;
            }
            .stack-value-last {
                padding-bottom: 0 !important;
                margin-bottom: 0 !important;
            }
            .stack-value-last table {
                float: none !important;
            }
        }
    </style>
    <center style="width: 100%; background-color: #f7f7f7; padding: 0">
        <div style="max-width: 600px; background-color: #f7f7f7">
            <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="
						background-color: #f7f7f7;
						color: #000000;
						margin: 0;
						padding: 0;
						max-width: 600px;
						width: 100%;
						font-family: 'Roboto', Arial, sans-serif;
					">
                {{> header}}
                <tr>
                    <td>
                        <table role="presentation" width="100%" align="center" border="0" cellpadding="0" cellspacing="0" bgcolor="#ffffff" style="width:100%; max-width:632px; border-collapse:collapse; background-color:#ffffff; border-radius:16px;">
                            <tr>
                                <td align="center" style="padding:34px 4px 4px 4px;">
                                    <!--[if mso]>
                                    <table role="presentation" width="592" align="center" border="0" cellpadding="0" cellspacing="0"><tr><td>
                                    <![endif]-->
                                    <table class="email-container" role="presentation" width="100%" align="center" border="0" cellpadding="0" cellspacing="0" style="width:100%; max-width:624px; border-collapse:collapse;">
                                        <tr>
                                            <td align="center" style="padding:0 0 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:28px; line-height:36px; font-weight:500; color:#000000; mso-line-height-rule:exactly;">{{depositAmlBlocked.titleLabel}}</td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="padding:0 0 16px 0;">
                                                <img src="https://cdn.dv.net/img/currency/70/{{blockchainCurrencyId}}.png" width="70" height="70" alt="{{tokenSymbol}}" style="display:block; width:70px; height:70px; border:0; border-radius:8px; outline:none; text-decoration:none;" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="padding:0 0 4px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:500; color:#6b6d80; mso-line-height-rule:exactly;">{{depositAmlBlocked.amountLabel}}</td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="padding:0 0 16px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:34px; line-height:34px; font-weight:500; color:#303345; mso-line-height-rule:exactly;">{{tokenAmount}} {{tokenSymbol}}</td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="padding:0 0 32px 0;">
                                                <table role="presentation" align="center" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                    <tr>
                                                        <td align="center" style="padding:0 6px 0 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:500; color:#6b6d80; white-space:nowrap; mso-line-height-rule:exactly;">≈ ${{usdAmount}}</td>
                                                        <td align="center" style="font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:500; color:#6b6d80; white-space:nowrap; mso-line-height-rule:exactly;">{{depositAmlBlocked.networkLabelPrefix}} {{blockchainName}} {{depositAmlBlocked.networkLabelPostfix}}</td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td align="center" style="padding:0 30px 32px 30px; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#303345; text-align:center; mso-line-height-rule:exactly;">{{depositAmlBlocked.messageText}}</td>
                                        </tr>
                                        <tr>
                                            <td bgcolor="#f7f9fb" style="background-color:#f7f9fb; border-radius:16px; padding:34px 30px;">
                                                <!-- Transaction hash -->
                                                <table class="rows" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                    <tr>
                                                        <td class="stack stack-label" valign="middle" style="padding:0 62px 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#a4a5b1; white-space:nowrap; vertical-align:middle; mso-line-height-rule:exactly;">{{depositAmlBlocked.transactionHashLabel}}</td>
                                                        <td class="stack stack-value" width="100%" valign="middle" align="right" style="width:100%; padding:0 0 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:500; color:#303345; text-align:right; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere; mso-line-height-rule:exactly;">{{transactionHash}}</td>
                                                    </tr>
                                                </table>
                                                <!-- Deposit address -->
                                                <table class="rows" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                    <tr>
                                                        <td class="stack stack-label" valign="middle" style="padding:0 62px 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#a4a5b1; white-space:nowrap; vertical-align:middle; mso-line-height-rule:exactly;">{{depositAmlBlocked.toAddressLabel}}</td>
                                                        <td class="stack stack-value" width="100%" valign="middle" align="right" style="width:100%; padding:0 0 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:500; color:#303345; text-align:right; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere; mso-line-height-rule:exactly;">{{toAddress}}</td>
                                                    </tr>
                                                </table>
                                                <!-- Payment date -->
                                                <table class="rows" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                    <tr>
                                                        <td class="stack stack-label" valign="middle" style="padding:0 62px 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#a4a5b1; white-space:nowrap; vertical-align:middle; mso-line-height-rule:exactly;">{{depositAmlBlocked.paymentDateLabel}}</td>
                                                        <td class="stack stack-value" width="100%" valign="middle" align="right" style="width:100%; padding:0 0 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:500; color:#303345; text-align:right; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere; mso-line-height-rule:exactly;">{{paymentDate}}</td>
                                                    </tr>
                                                </table>
                                                <!-- Blocked transaction ID -->
                                                <table class="rows" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                    <tr>
                                                        <td class="stack stack-label" valign="middle" style="padding:0 62px 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#a4a5b1; white-space:nowrap; vertical-align:middle; mso-line-height-rule:exactly;">{{depositAmlBlocked.blockedIdLabel}}</td>
                                                        <td class="stack stack-value" width="100%" valign="middle" align="right" style="width:100%; padding:0 0 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:500; color:#303345; text-align:right; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere; mso-line-height-rule:exactly;">{{blockedTransactionId}}</td>
                                                    </tr>
                                                </table>
                                                <!-- Risk score -->
                                                <table class="rows" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                    <tr>
                                                        <td class="stack stack-label" valign="middle" style="padding:0 62px 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#a4a5b1; white-space:nowrap; vertical-align:middle; mso-line-height-rule:exactly;">{{depositAmlBlocked.riskScoreLabel}}</td>
                                                        <td class="stack stack-value" width="100%" valign="middle" align="right" style="width:100%; padding:0 0 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:500; color:#303345; text-align:right; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere; mso-line-height-rule:exactly;">{{riskScore}}</td>
                                                    </tr>
                                                </table>
                                                <!-- Risk level -->
                                                <table class="rows" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                    <tr>
                                                        <td class="stack stack-label" valign="middle" style="padding:0 62px 0 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#a4a5b1; white-space:nowrap; vertical-align:middle; mso-line-height-rule:exactly;">{{depositAmlBlocked.riskLevelLabel}}</td>
                                                        <td class="stack stack-value stack-value-last" width="100%" valign="middle" align="right" style="width:100%; padding:0; text-align:right; vertical-align:middle;">
                                                            <table role="presentation" align="right" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                                <tr>
                                                                    <td align="center" bgcolor="#ef4444" style="background-color:#ef4444; border-radius:100px; padding:4px 8px; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:14px; line-height:20px; font-weight:500; color:#ffffff; white-space:nowrap; mso-line-height-rule:exactly;">{{riskLevelText}}</td>
                                                                </tr>
                                                            </table>
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        {{#hasBlockReasons}}
                                        <tr>
                                            <td style="padding:24px 0 0 0;">
                                                <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#fdf2f2" style="width:100%; border-collapse:collapse; background-color:#fdf2f2; border-radius:16px;">
                                                    <tr>
                                                        <td style="padding:34px 30px 10px 30px;">
                                                            <table role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                                <tr>
                                                                    <td style="padding:0 0 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:18px; line-height:24px; font-weight:500; color:#303345; mso-line-height-rule:exactly;">{{depositAmlBlocked.reasonsTitle}}</td>
                                                                </tr>
                                                            </table>
                                                            {{#blockReasons}}
                                                            <table class="rows" role="presentation" width="100%" border="0" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                                                                <tr>
                                                                    <td class="stack stack-label" valign="middle" style="padding:0 62px 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#a4a5b1; white-space:nowrap; vertical-align:middle; mso-line-height-rule:exactly;">{{#isTotalRiskScore}}{{depositAmlBlocked.reasons.totalRiskScore}}{{/isTotalRiskScore}}{{#isSumOfSignals}}{{depositAmlBlocked.reasons.sumOfSignals}}{{/isSumOfSignals}}{{#isRiskLevel}}{{depositAmlBlocked.reasons.riskLevel}}{{/isRiskLevel}}{{#isSignal}}{{depositAmlBlocked.reasons.signal}}{{/isSignal}}</td>
                                                                    <td class="stack stack-value" width="100%" valign="middle" align="right" style="width:100%; padding:0 0 24px 0; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:20px; font-weight:500; color:#303345; text-align:right; vertical-align:middle; word-break:break-all; overflow-wrap:anywhere; mso-line-height-rule:exactly;">{{#isTotalRiskScore}}{{value}}{{/isTotalRiskScore}}{{#isSumOfSignals}}{{value}}{{/isSumOfSignals}}{{#isRiskLevel}}{{riskLevelText}}{{/isRiskLevel}}{{#isSignal}}{{#signalLabel}}{{signalLabel}}{{/signalLabel}}{{^signalLabel}}{{depositAmlBlocked.reasons.unknownSignal}}{{/signalLabel}} ({{value}}){{/isSignal}}</td>
                                                                </tr>
                                                            </table>
                                                            {{/blockReasons}}
                                                        </td>
                                                    </tr>
                                                </table>
                                            </td>
                                        </tr>
                                        {{/hasBlockReasons}}
                                        <tr>
                                            <td align="center" style="padding:32px 30px 30px 30px; font-family:'Roboto', Arial, Helvetica, sans-serif; font-size:16px; line-height:24px; font-weight:400; color:#6b6d80; text-align:center; mso-line-height-rule:exactly;">{{depositAmlBlocked.refundText}}</td>
                                        </tr>
                                    </table>
                                    <!--[if mso]>
                                    </td></tr></table>
                                    <![endif]-->
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
                {{> footer}}
            </table>
        </div>
    </center>
</body>
</html>
